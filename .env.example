# Sao chep file nay thanh ".env" (cung thu muc) roi sua neu can.
# File .env KHONG duoc dua len Git (da co trong .gitignore).

# Cong may chu lang nghe (so tu 1 den 65535)
CONG=3000

# Duong dan file du lieu SQLite (tinh tu thu muc goc cua du an)
DUONG_DAN_DB=du-lieu/hrm.db

# Bat HTTPS hay khong (true hoac false). Buoc 11 se lam phan nay.
BAT_HTTPS=false
